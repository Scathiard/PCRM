<local:OperationDialog x:Class="McResourceManager.Desktop.FirstRunOnboardingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McResourceManager.Desktop" Title="开始使用 PCRM" Width="850" Height="660" WindowStartupLocation="CenterOwner" Loaded="InitializeDialog">
  <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="把分散的资源，整理到一起" Style="{StaticResource Title}"/><TextBlock Text="选择主库 → 添加实例 → 扫描并确认收编 → 查看节省空间" Style="{StaticResource Meta}" Margin="0,0,0,20"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><ProgressBar x:Name="DialogProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed"/><TextBlock x:Name="Feedback" Style="{StaticResource Meta}" Margin="0,10"/><Button Content="稍后设置 / 关闭" Click="CancelDialog" HorizontalAlignment="Right"/></StackPanel>
    <Grid x:Name="Form">
      <StackPanel x:Name="LibraryStep"><TextBlock Text="1  选择主资源库" FontWeight="SemiBold"/><TextBlock Text="光影、资源包、模型和枪包将在这里集中存放。请使用独立于游戏实例的文件夹。" Style="{StaticResource Meta}" Margin="0,12"/><TextBox x:Name="LibraryPath" AutomationProperties.AutomationId="MasterPath"/><WrapPanel><Button Content="选择文件夹" Click="PickLibrary"/><Button Content="创建或打开主库" Click="ConfigureLibrary" Style="{StaticResource Primary}" AutomationProperties.AutomationId="ConfigureLibrary"/></WrapPanel><TextBlock Text="经 PCRM 导入的新版本会与旧版并存。&#10;在资源管理器里直接覆盖共享文件时，原内容无法自动找回。" Style="{StaticResource Meta}" Margin="0,22"/></StackPanel>
      <DockPanel x:Name="InstancesStep" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><TextBlock Text="2  添加已有实例" FontWeight="SemiBold"/><TextBlock Text="选择单个实例，或启动器 / .minecraft 根目录，再勾选要管理的实例。" Style="{StaticResource Meta}" Margin="0,12"/><TextBox x:Name="InstancePath" AutomationProperties.AutomationId="InstancePath"/><WrapPanel><Button Content="选择目录" Click="PickInstances"/><Button Content="探测实例" Click="ProbeInstances" AutomationProperties.AutomationId="ProbeInstances"/></WrapPanel></StackPanel><Button DockPanel.Dock="Bottom" Content="登记所选实例并扫描资源" Click="RegisterInstances" Style="{StaticResource Primary}" AutomationProperties.AutomationId="RegisterInstances"/><DataGrid x:Name="InstanceCandidates" Margin="0,12"><DataGrid.Columns><DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="实例" Binding="{Binding Name}" Width="160" IsReadOnly="True"/><DataGridTextColumn Header="目录" Binding="{Binding Path}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid></DockPanel>
      <StackPanel x:Name="CompleteStep" Visibility="Collapsed"><TextBlock Text="资源工作台已准备好" Style="{StaticResource Title}"/><TextBlock x:Name="OnboardingSummary" Style="{StaticResource Meta}"/><Button Content="进入工作台" Click="EnterWorkspace" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,24" AutomationProperties.AutomationId="EnterWorkspace"/></StackPanel>
    </Grid>
  </DockPanel>
</local:OperationDialog>
