<local:OperationDialog x:Class="McResourceManager.Desktop.HarvestDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McResourceManager.Desktop" Title="扫描与收编现有资源" Width="1040" Height="660" WindowStartupLocation="CenterOwner" Loaded="InitializeDialog">
  <DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="收编已有资源，合并重复文件" Style="{StaticResource Title}"/><TextBlock Text="同内容可直接转共享，新资源复制入库后再共享；原有不同版本默认保留为新版本。" Style="{StaticResource Meta}" Margin="0,0,0,14"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><ProgressBar x:Name="DialogProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="Feedback" Style="{StaticResource Meta}" Margin="0,10"/><Button Content="稍后处理 / 关闭" Click="CancelDialog" HorizontalAlignment="Right" AutomationProperties.AutomationId="CloseHarvest"/></StackPanel>
    <DockPanel x:Name="Form"><Button DockPanel.Dock="Bottom" Content="确认并执行所选操作" Click="Execute" Style="{StaticResource Primary}" HorizontalAlignment="Right" AutomationProperties.AutomationId="ExecuteHarvest"/><DataGrid x:Name="HarvestGrid" AutomationProperties.AutomationId="HarvestGrid"><DataGrid.Columns><DataGridCheckBoxColumn Header="选择" Width="50" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="实例" Width="130" Binding="{Binding InstanceName}" IsReadOnly="True"/><DataGridTextColumn Header="资源" Width="*" Binding="{Binding Candidate.EntryName}" IsReadOnly="True"/><DataGridTextColumn Header="扫描结果" Width="170" Binding="{Binding Category}" IsReadOnly="True"/><DataGridTemplateColumn Header="确认操作" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding ActionLabel,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel>
  </DockPanel>
</local:OperationDialog>
