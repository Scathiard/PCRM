<Window x:Class="McResourceManager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PCRM - Plain Craft Resources Manager" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="OnLoaded" Activated="OnActivated" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
  <Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Brush.Header}" MouseLeftButtonDown="DragHeader"><Grid Margin="18,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="PCRM" Foreground="{StaticResource Brush.Panel}" FontSize="{StaticResource Size.Title}" FontWeight="Bold"/><TextBlock Text=" / Plain Craft Resources Manager" Foreground="{StaticResource Brush.Panel}" FontSize="{StaticResource Size.Meta}" Margin="8,0"/></StackPanel>
      <StackPanel x:Name="PageTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="实例" Tag="Instances" Click="ChangePage" Style="{StaticResource HeaderTab}" AutomationProperties.AutomationId="InstancesTab"/><Button Content="资源库" Tag="Library" Click="ChangePage" Style="{StaticResource HeaderTab}" AutomationProperties.AutomationId="LibraryTab"/><Button Content="工具" Tag="Tools" Click="ChangePage" Style="{StaticResource HeaderTab}" AutomationProperties.AutomationId="ToolsTab"/><Button Content="设置" Tag="Settings" Click="ChangePage" Style="{StaticResource HeaderTab}" AutomationProperties.AutomationId="SettingsTab"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="—" Click="MinimizeWindow" ToolTip="最小化"/><Button Content="□" Click="MaximizeWindow" ToolTip="最大化或还原"/><Button Content="×" Click="CloseWindow" ToolTip="关闭"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1" Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Breadcrumb" Text="实例 / 工作台" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"/>
      <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="420" HorizontalAlignment="Left" Width="360" TextChanged="SearchChanged" ToolTip="搜索名称、文件名或状态（Ctrl+K）" AutomationProperties.AutomationId="Search"/>
      <TextBlock Grid.Column="1" Text="搜索名称、文件名或状态   Ctrl K" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Brush.Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="ReviewButton" Content="检查主库变动" Click="ReviewChanges"/><TextBlock x:Name="SavingsLabel" Text="资源集中，按需共享" Style="{StaticResource Meta}" Margin="12,0"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2" x:Name="WorkspaceGrid" Margin="12,0,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="SidebarTitle" Text="我的实例" Style="{StaticResource Title}"/><Button x:Name="AddInstanceButton" Content="＋ 添加实例" Click="AddInstances"/><Button x:Name="AddTypeButton" Content="＋ 自定义资源类型" Click="AddType" Visibility="Collapsed"/><Separator Margin="0,8"/></StackPanel><ListBox x:Name="Sidebar" SelectionChanged="SidebarChanged" AutomationProperties.AutomationId="Sidebar"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Meta}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxHeight="36"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Top"><Grid><TextBlock x:Name="ContentTitle" Text="资源工作台" Style="{StaticResource Title}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="刷新" Click="RefreshClicked"/><Button Content="导入资源" Click="ImportFiles" Style="{StaticResource Primary}" AutomationProperties.AutomationId="ImportResources"/></StackPanel></Grid><TextBlock x:Name="ContentSubtitle" Text="拖入文件或文件夹，确认后安全入库。" Style="{StaticResource Meta}" Margin="0,0,0,12"/></StackPanel>
        <Grid><TextBlock x:Name="EmptyHint" Text="这里还没有资源。&#10;可以导入资源，或扫描实例中的现有文件。" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Meta}"/>
          <ListBox x:Name="ResourceList" SelectionChanged="ResourceSelected" AutomationProperties.AutomationId="ResourceList">
            <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Margin="0,4,0,8"><Expander.Header><TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold" FontSize="{StaticResource Size.CardTitle}"/></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
            <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="36" Height="36" Background="{StaticResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Control}"><Grid><TextBlock Text="▦" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Accent}"/><Image Source="{Binding Cover}" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding FileName}" Style="{StaticResource Meta}" FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis"/></StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"><Ellipse Width="6" Height="6" Fill="{Binding StateBrush}"/><TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Size.Meta}" Margin="5,0"/></StackPanel>
              <Button Grid.Column="3" Content="{Binding VersionCaption}" Tag="{Binding}" Click="OpenVersions" FontFamily="{StaticResource Font.Mono}" AutomationProperties.AutomationId="VersionButton"/>
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </DockPanel></Border>
      <Border Grid.Column="4" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Height="190" Background="{StaticResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Panel}"><Grid><TextBlock Text="PCRM" Foreground="{StaticResource Brush.Accent}" FontSize="{StaticResource Size.Title}" HorizontalAlignment="Center"/><Image x:Name="DetailCover" Width="148" Height="148" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid></Border>
        <TextBlock x:Name="DetailTitle" Text="选择一个资源" Style="{StaticResource Title}" Margin="0,16,0,6" TextWrapping="Wrap"/><TextBlock x:Name="DetailState" Style="{StaticResource Meta}" Text="在这里查看版本、简介和使用情况。"/>
        <TextBlock Text="显示名称" Margin="0,16,0,0" Style="{StaticResource Meta}"/><TextBox x:Name="NameEditor" AutomationProperties.AutomationId="ResourceName"/>
        <TextBlock Text="简介与备注" Style="{StaticResource Meta}"/><TextBox x:Name="DescriptionEditor" AcceptsReturn="True" Height="84" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <WrapPanel><Button x:Name="SaveDetailsButton" Content="保存详情" Click="SaveDetails" AutomationProperties.AutomationId="SaveDetails"/><Button x:Name="ChangeCoverButton" Content="更换封面" Click="ChangeCover"/></WrapPanel>
        <TextBlock Text="版本记录" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBlock x:Name="VersionHistory" Style="{StaticResource Meta}"/>
        <TextBlock x:Name="UsageText" Style="{StaticResource Meta}" Margin="0,10"/>
        <WrapPanel><Button Content="定位文件" Click="LocateFile"/><Button x:Name="GroupVersionButton" Content="调整版本归组" Click="GroupVersion"/><Button x:Name="DetachButton" Content="转为独立副本" Click="DetachResource"/><Button x:Name="RemoveButton" Content="从实例移除" Click="RemoveResource" Style="{StaticResource Danger}"/></WrapPanel>
        <Expander Header="高级信息" Margin="0,14,0,0"><TextBox x:Name="AdvancedInfo" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Meta}" BorderThickness="0" AcceptsReturn="True"/></Expander>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="2" x:Name="ToolsPage" Style="{StaticResource Panel}" Margin="12" Visibility="Collapsed"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="工具" Style="{StaticResource Title}"/><TextBlock Text="整理已经使用的资源，检查共享状态。" Style="{StaticResource Meta}"/><Button Content="扫描并收编现有实例" Click="HarvestInstances" Margin="0,24,0,8" HorizontalAlignment="Left"/><TextBlock Text="比较内容并去重，将现有文件接入资源库；操作前会显示确认清单。" Style="{StaticResource Meta}"/><Button Content="全局健康检查" Click="HealthCheck" Margin="0,24,0,8" HorizontalAlignment="Left" AutomationProperties.AutomationId="HealthCheck"/><TextBox x:Name="HealthReport" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="300" Width="680" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
    <Border Grid.Row="2" x:Name="SettingsPage" Style="{StaticResource Panel}" Margin="12" Visibility="Collapsed"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="设置" Style="{StaticResource Title}"/><TextBlock Text="主资源库" FontWeight="SemiBold"/><TextBlock x:Name="MasterPathText" Style="{StaticResource Meta}" Margin="0,6"/><WrapPanel><Button Content="配置主库与实例" Click="SetupClicked"/><Button Content="设置跨盘共享缓存区" Click="SetupReplica"/><Button Content="新增自定义资源类型" Click="AddType"/></WrapPanel><CheckBox x:Name="UpdateCompanion" IsChecked="True" Content="切换版本时同步游戏内启用配置与光影参数" Margin="3,20"/><TextBlock Text="资源导入会复制到主库，保留源文件；同名新版本会并存。&#10;如果在资源管理器中直接覆盖共享文件，PCRM 只能检测变化，无法找回被覆盖的内容。" Style="{StaticResource Meta}"/><TextBlock Text="PCRM - Plain Craft Resources Manager" Foreground="{StaticResource Brush.Accent}" Margin="0,30,0,0"/></StackPanel></Border>
    <Grid Grid.Row="3" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource Meta}" TextTrimming="CharacterEllipsis"/><Button x:Name="CancelButton" Grid.Column="1" Content="取消当前操作" Click="CancelOperation" Visibility="Collapsed"/><ProgressBar x:Name="BusyBar" Grid.Column="2" Height="3" IsIndeterminate="True" Visibility="Collapsed"/></Grid>
    <Popup x:Name="VersionPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Style="{StaticResource Panel}" Width="320" Margin="4"><StackPanel><TextBlock Text="选择资源版本" FontWeight="SemiBold"/><ListBox x:Name="VersionList" MaxHeight="240" DisplayMemberPath="Label" AutomationProperties.AutomationId="VersionList">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="IsEnabled" Value="{Binding CanDeploy}"/></Style></ListBox.ItemContainerStyle>
    </ListBox><TextBlock Text="投放到实例" Style="{StaticResource Meta}"/><ComboBox x:Name="DeployInstance" DisplayMemberPath="DisplayName" SelectedValuePath="InstanceId" SelectionChanged="VersionTargetChanged"/><Button Content="切换到此版本" IsEnabled="{Binding SelectedItem.CanDeploy,ElementName=VersionList,FallbackValue=False,TargetNullValue=False}" Click="SwitchVersion" Style="{StaticResource Primary}" AutomationProperties.AutomationId="ConfirmVersion"/></StackPanel></Border></Popup>
  </Grid>
</Window>
