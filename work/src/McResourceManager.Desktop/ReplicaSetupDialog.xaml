<local:OperationDialog x:Class="McResourceManager.Desktop.ReplicaSetupDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McResourceManager.Desktop" Title="跨盘共享缓存区" Width="660" Height="400" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24"><TextBlock Text="设置跨盘共享缓存区" Style="{StaticResource Title}"/><TextBlock Text="为实例所在磁盘选择一个独立文件夹。同盘实例共用一份按需缓存，主库原件保持独立。" Style="{StaticResource Meta}"/><StackPanel x:Name="Form" Margin="0,16"><TextBlock Text="目标磁盘（例如 E:\）"/><TextBox x:Name="VolumePath"/><TextBlock Text="缓存区文件夹"/><TextBox x:Name="CachePath"/><WrapPanel><Button Content="选择文件夹" Click="PickPath"/><Button Content="保存" Click="Save" Style="{StaticResource Primary}"/></WrapPanel></StackPanel><TextBlock x:Name="Feedback" Style="{StaticResource Meta}"/><Button Content="取消" Click="CancelDialog" HorizontalAlignment="Right"/></StackPanel>
</local:OperationDialog>
