<local:OperationDialog x:Class="McResourceManager.Desktop.ResourceTypeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McResourceManager.Desktop" Title="自定义资源类型" Width="650" Height="470" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24"><TextBlock Text="按资源应该放在哪里，定义新类型" Style="{StaticResource Title}"/><StackPanel x:Name="Form"><TextBlock Text="类型名称"/><TextBox x:Name="TypeName" AutomationProperties.AutomationId="TypeName"/><TextBlock Text="实例中的相对目录，例如 schematics 或 config/example/models" Style="{StaticResource Meta}"/><TextBox x:Name="RelativePath" AutomationProperties.AutomationId="TypePath"/><TextBlock Text="主库中的文件夹名称，例如 schematics" Style="{StaticResource Meta}"/><TextBox x:Name="FolderName" AutomationProperties.AutomationId="TypeFolder"/><TextBlock Text="忽略文件规则，以分号分隔，例如 *.txt;thumbs.db" Style="{StaticResource Meta}"/><TextBox x:Name="IgnorePatterns"/><Button Content="添加类型" Click="Save" Style="{StaticResource Primary}" HorizontalAlignment="Right" AutomationProperties.AutomationId="SaveType"/></StackPanel><TextBlock x:Name="Feedback" Style="{StaticResource Meta}"/><Button Content="取消" Click="CancelDialog" HorizontalAlignment="Right"/></StackPanel>
</local:OperationDialog>
