<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB"/><SolidColorBrush x:Key="Brush.AccentSoft" Color="#E7EFFF"/>
  <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF"/><SolidColorBrush x:Key="Brush.Line" Color="#E1E9F4"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="#F3F7FE"/><SolidColorBrush x:Key="Brush.Selection" Color="#E8F0FF"/>
  <SolidColorBrush x:Key="Brush.Text" Color="#1F2A3D"/><SolidColorBrush x:Key="Brush.Secondary" Color="#55647A"/><SolidColorBrush x:Key="Brush.Muted" Color="#8A97AB"/>
  <SolidColorBrush x:Key="Brush.Input" Color="#F4F7FC"/><SolidColorBrush x:Key="Brush.InputLine" Color="#DCE5F1"/>
  <SolidColorBrush x:Key="Brush.State.LinkedLatest" Color="#14904A"/><SolidColorBrush x:Key="Brush.State.LinkedOldVersion" Color="#2563EB"/>
  <SolidColorBrush x:Key="Brush.State.ControlledCopy" Color="#C07605"/><SolidColorBrush x:Key="Brush.State.TamperedAlert" Color="#D92D2D"/>
  <SolidColorBrush x:Key="Brush.State.WildUntracked" Color="#64748B"/><SolidColorBrush x:Key="Brush.WarningSoft" Color="#FFF2DA"/>
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FDEAEA"/><SolidColorBrush x:Key="Brush.Transparent" Color="Transparent"/>
  <LinearGradientBrush x:Key="Brush.Header" StartPoint="0,0" EndPoint="1,0.2"><GradientStop Color="#2563EB"/><GradientStop Color="#3B82F6" Offset="0.55"/><GradientStop Color="#1FA8E6" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E9F1FC"/><GradientStop Color="#F4F8FD" Offset="0.6"/><GradientStop Color="#EDF6F8" Offset="1"/></LinearGradientBrush>
  <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI</FontFamily><FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="Size.Title">19</sys:Double><sys:Double x:Key="Size.CardTitle">14.5</sys:Double><sys:Double x:Key="Size.Body">14</sys:Double>
  <sys:Double x:Key="Size.Button">13</sys:Double><sys:Double x:Key="Size.Meta">12</sys:Double><sys:Double x:Key="Size.Badge">11</sys:Double>
  <CornerRadius x:Key="Radius.Panel">10</CornerRadius><CornerRadius x:Key="Radius.Control">6</CornerRadius><CornerRadius x:Key="Radius.Pill">16</CornerRadius>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/><Setter Property="FontSize" Value="{StaticResource Size.Body}"/><Setter Property="Foreground" Value="{StaticResource Brush.Text}"/><Setter Property="Background" Value="{StaticResource Brush.Window}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource Size.Title}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Meta" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Secondary}"/><Setter Property="FontSize" Value="{StaticResource Size.Meta}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/><Setter Property="Padding" Value="16"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Brush.Panel}"/><Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.InputLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="{StaticResource Size.Button}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Brush.Accent}"/><Setter Property="Foreground" Value="{StaticResource Brush.Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/></Style>
  <Style x:Key="HeaderTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="16,6" CornerRadius="{StaticResource Radius.Pill}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{StaticResource Brush.State.TamperedAlert}"/><Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Brush.Input}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.InputLine}"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="ListBox"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource Brush.Transparent}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowBorder" Background="{StaticResource Brush.Transparent}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource Brush.Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/><Setter Property="RowBackground" Value="{StaticResource Brush.Panel}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.Hover}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Line}"/><Setter Property="RowHeight" Value="40"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
</ResourceDictionary>
