<local:OperationDialog x:Class="McResourceManager.Desktop.VersionGroupingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McResourceManager.Desktop" Title="调整版本归组" Width="580" Height="360" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24"><TextBlock Text="调整版本归组" Style="{StaticResource Title}"/><TextBlock Text="调整资源库中的版本关系，磁盘中的资源文件保持原样。" Style="{StaticResource Meta}"/><StackPanel x:Name="Form" Margin="0,16"><TextBlock Text="选择版本"/><ComboBox x:Name="SourceVersion" DisplayMemberPath="VersionLabel" SelectedValuePath="VersionId"/><TextBlock Text="归组到"/><ComboBox x:Name="Destination" DisplayMemberPath="Name" SelectedValuePath="Id"/><Button Content="确认调整" Click="Save" Style="{StaticResource Primary}"/></StackPanel><TextBlock x:Name="Feedback" Style="{StaticResource Meta}"/><Button Content="取消" Click="CancelDialog" HorizontalAlignment="Right"/></StackPanel>
</local:OperationDialog>
